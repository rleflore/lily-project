{"items":[{"str":"T W O","dir":"ltr","width":34,"height":11,"transform":[11,0,0,11,283,635],"fontName":"g_d2896_f1","hasEOL":false},{"str":"","dir":"ltr","width":0,"height":0,"transform":[17,0,0,17,207,593],"fontName":"g_d2896_f2","hasEOL":true},{"str":"Cultural Studies, Popular","dir":"ltr","width":187,"height":17,"transform":[17,0,0,17,207,593],"fontName":"g_d2896_f2","hasEOL":true},{"str":"Culture, and Pedagogy","dir":"ltr","width":171,"height":17,"transform":[17,0,0,17,214,565],"fontName":"g_d2896_f2","hasEOL":false},{"str":"","dir":"ltr","width":0,"height":0,"transform":[11,0,0,11,226,446],"fontName":"g_d2896_f1","hasEOL":true},{"str":"A. Overview and Background","dir":"ltr","width":148,"height":11,"transform":[11,0,0,11,226,446],"fontName":"g_d2896_f1","hasEOL":false},{"str":"","dir":"ltr","width":0,"height":0,"transform":[10,0,0,10,144,425],"fontName":"g_d2896_f2","hasEOL":true},{"str":"In England, where cultural studies originated, its disciplinary center","dir":"ltr","width":312,"height":10,"transform":[10,0,0,10,144,425],"fontName":"g_d2896_f2","hasEOL":true},{"str":"was sociology. Perhaps most influential to the later American develop-","dir":"ltr","width":312,"height":10,"transform":[10,0,0,10,144,411],"fontName":"g_d2896_f2","hasEOL":true},{"str":"ment of the field was Stuart Hall, a Black sociologist who directed, for","dir":"ltr","width":312,"height":10,"transform":[10,0,0,10,144,397],"fontName":"g_d2896_f2","hasEOL":true},{"str":"a time, the Center for Contemporary Cultural Studies in Birming-","dir":"ltr","width":312,"height":10,"transform":[10,0,0,10,144,383],"fontName":"g_d2896_f2","hasEOL":true},{"str":"ham.","dir":"ltr","width":22,"height":10,"transform":[10,0,0,10,144,369],"fontName":"g_d2896_f2","hasEOL":false},{"str":" ","dir":"ltr","width":0,"height":0,"transform":[10,0,0,10,166,369],"fontName":"g_d2896_f2","hasEOL":false},{"str":"1","dir":"ltr","width":4,"height":7,"transform":[7,0,0,7,166,372],"fontName":"g_d2896_f2","hasEOL":false},{"str":" ","dir":"ltr","width":0,"height":0,"transform":[7,0,0,7,170,372],"fontName":"g_d2896_f2","hasEOL":false},{"str":"In its inception, cultural studies grew out of the experience of","dir":"ltr","width":282,"height":10,"transform":[10,0,0,10,174,369],"fontName":"g_d2896_f2","hasEOL":true},{"str":"educating working-class people with a commitment to the political ap-","dir":"ltr","width":312,"height":10,"transform":[10,0,0,10,144,355],"fontName":"g_d2896_f2","hasEOL":true},{"str":"plications of knowledge and criticism; it was also therefore committed","dir":"ltr","width":312,"height":10,"transform":[10,0,0,10,144,341],"fontName":"g_d2896_f2","hasEOL":true},{"str":"to a kind of theorizing and critical practice that had social change as","dir":"ltr","width":312,"height":10,"transform":[10,0,0,10,144,327],"fontName":"g_d2896_f2","hasEOL":true},{"str":"one of its goals. It took as its object of study the everyday culture and","dir":"ltr","width":312,"height":10,"transform":[10,0,0,10,144,313],"fontName":"g_d2896_f2","hasEOL":true},{"str":"practices of people.","dir":"ltr","width":86,"height":10,"transform":[10,0,0,10,144,299],"fontName":"g_d2896_f2","hasEOL":true},{"str":"The definition of “culture” for cultural studies comes from the","dir":"ltr","width":300,"height":10,"transform":[10,0,0,10,156,285],"fontName":"g_d2896_f2","hasEOL":true},{"str":"British Marxist critic Raymond Williams, who argued that culture is a","dir":"ltr","width":312,"height":10,"transform":[10,0,0,10,144,271],"fontName":"g_d2896_f2","hasEOL":true},{"str":"whole way of life (ideas, attitudes, languages, practices, institutions,","dir":"ltr","width":312,"height":10,"transform":[10,0,0,10,144,257],"fontName":"g_d2896_f2","hasEOL":true},{"str":"structures of power) and a whole range of cultural practices: artistic","dir":"ltr","width":312,"height":10,"transform":[10,0,0,10,144,243],"fontName":"g_d2896_f2","hasEOL":true},{"str":"forms, texts, canons, architecture, mass-produced commodities, and","dir":"ltr","width":312,"height":10,"transform":[10,0,0,10,144,229],"fontName":"g_d2896_f2","hasEOL":true},{"str":"so on. Culture means the actual grounded terrain of practices, repre-","dir":"ltr","width":312,"height":10,"transform":[10,0,0,10,144,215],"fontName":"g_d2896_f2","hasEOL":true},{"str":"sentations, languages, and customs of any specific historical society.","dir":"ltr","width":312,"height":10,"transform":[10,0,0,10,144,201],"fontName":"g_d2896_f2","hasEOL":true},{"str":"Culture, in other words, means not only “high culture,” what we usu-","dir":"ltr","width":312,"height":10,"transform":[10,0,0,10,144,187],"fontName":"g_d2896_f2","hasEOL":true},{"str":"ally call art or literature, but also the everyday practices, representa-","dir":"ltr","width":312,"height":10,"transform":[10,0,0,10,144,173],"fontName":"g_d2896_f2","hasEOL":true},{"str":"tions, and cultural productions of people and of","dir":"ltr","width":218,"height":10,"transform":[10,0,0,10,144,159],"fontName":"g_d2896_f2","hasEOL":false},{"str":" ","dir":"ltr","width":0,"height":0,"transform":[10,0,0,10,362,159],"fontName":"g_d2896_f2","hasEOL":false},{"str":"postindustrial","dir":"ltr","width":66,"height":10,"transform":[10,0,0,10,365,159],"fontName":"g_d2896_f1","hasEOL":false},{"str":" ","dir":"ltr","width":0,"height":0,"transform":[10,0,0,10,432,159],"fontName":"g_d2896_f1","hasEOL":false},{"str":"soci-","dir":"ltr","width":21,"height":10,"transform":[10,0,0,10,435,159],"fontName":"g_d2896_f2","hasEOL":true},{"str":"eties.","dir":"ltr","width":23,"height":10,"transform":[10,0,0,10,144,145],"fontName":"g_d2896_f2","hasEOL":false},{"str":" ","dir":"ltr","width":0,"height":0,"transform":[10,0,0,10,167,145],"fontName":"g_d2896_f2","hasEOL":false},{"str":"2","dir":"ltr","width":4,"height":7,"transform":[7,0,0,7,167,148],"fontName":"g_d2896_f2","hasEOL":true},{"str":"| 13 |","dir":"ltr","width":26,"height":9,"transform":[9,0,0,9,287,117],"fontName":"g_d2896_f2","hasEOL":false}],"styles":{"g_d2896_f1":{"fontFamily":"serif","ascent":0.72,"descent":-0.245,"vertical":false},"g_d2896_f2":{"fontFamily":"serif","ascent":0.722,"descent":-0.246,"vertical":false}},"lang":null}